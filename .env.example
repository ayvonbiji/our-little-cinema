# Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key (sb_publishable_...) or legacy anon key. NEVER the secret key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Names shown in the header and profile chips (can be changed any time)
NEXT_PUBLIC_PERSON_ONE=Ayvon
NEXT_PUBLIC_PERSON_TWO=Aksa

# SERVER-ONLY secret key (Supabase → Project Settings → API Keys → Secret key, "sb_secret_...").
# Used only by the app's server to create signed upload/playback links for the private
# "room-videos" bucket. NEVER prefix it with NEXT_PUBLIC_ and never paste it anywhere public.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Largest upload in MB. Supabase Free allows 50 MB per file; on Pro raise the
# project limit (Storage → Settings) and then this number.
NEXT_PUBLIC_MAX_UPLOAD_MB=50
